{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serviceops.com/contracts/events/request.assigned.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "type", "schemaVersion", "requestId", "requestVersion", "recipientId", "correlationId", "occurredAt"],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "type": {"const": "request.assigned"},
    "schemaVersion": {"const": 1},
    "requestId": {"type": "string", "format": "uuid"},
    "requestVersion": {"type": "integer", "minimum": 0},
    "recipientId": {"type": "string", "format": "uuid"},
    "correlationId": {"type": "string", "format": "uuid"},
    "occurredAt": {"type": "string", "format": "date-time"}
  }
}
